<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ts_background"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TransferServis.Overline"
            android:text="@string/ux_brand" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TransferServis.ScreenTitle"
            android:layout_marginTop="8dp"
            android:accessibilityHeading="true"
            android:text="@string/ux_home_title" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pendingOrderNoticeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/ts_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ts_error"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pending_order_home_title"
                    android:textColor="@color/ts_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pending_order_home_message"
                    android:textColor="@color/ts_text_secondary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/pendingOrderReference"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/ts_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pendingOrderCopyButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/pending_order_copy_reference"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    app:cornerRadius="12dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pendingOrderRecoverButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/pending_order_recover"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:id="@+id/pendingOrderRecoveryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/ts_text_primary"
            android:textSize="14sp"
            android:visibility="gone" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.TransferServis.Card"
            android:visibility="gone"
            android:id="@+id/homeActiveOrderCard"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.TransferServis.Label"
                    android:text="@string/ux_your_trip" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.TransferServis.Status"
                    android:layout_marginTop="8dp"
                    android:id="@+id/homeActiveOrderStatus" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.TransferServis.SectionTitle"
                    android:layout_marginTop="8dp"
                    android:id="@+id/homeActiveOrderRoute" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.TransferServis.Body"
                    android:layout_marginTop="6dp"
                    android:id="@+id/homeActiveOrderMeta" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.TransferServis.Label"
                    android:layout_marginTop="6dp"
                    android:id="@+id/homeActiveOrderFreshness" />
                <com.google.android.material.button.MaterialButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/activeOrderButton"
                    android:text="@string/ux_open_trip"
                    style="@style/Widget.TransferServis.SecondaryButton"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.TransferServis.Card"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/quote_from_hint"
                        app:boxBackgroundColor="@color/ts_surface_high"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/ts_primary"
                        android:layout_weight="1">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/fromInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress"
                            android:maxLines="3"
                            android:textColor="@color/ts_text_primary"
                            android:textColorHint="@color/ts_text_muted"
                            android:textSize="16sp"
                            android:minHeight="56dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/favoritesFromButton"
                        android:text=""
                        style="@style/Widget.TransferServis.SecondaryButton"
                        android:layout_marginTop="12dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:contentDescription="@string/favorites_choose_from"
                        app:icon="@drawable/ic_favorite_outline"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:padding="12dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/swapRouteButton"
                        android:text=""
                        style="@style/Widget.TransferServis.SecondaryButton"
                        android:layout_marginTop="12dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:contentDescription="@string/home_swap_route"
                        app:icon="@drawable/ic_swap_vertical"
                        app:iconPadding="0dp"
                        android:padding="12dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/quote_to_hint"
                        app:boxBackgroundColor="@color/ts_surface_high"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/ts_primary"
                        android:layout_weight="1">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/toInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress"
                            android:maxLines="3"
                            android:textColor="@color/ts_text_primary"
                            android:textColorHint="@color/ts_text_muted"
                            android:textSize="16sp"
                            android:minHeight="56dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/favoritesToButton"
                        android:text=""
                        style="@style/Widget.TransferServis.SecondaryButton"
                        android:layout_marginTop="12dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:contentDescription="@string/favorites_choose_to"
                        app:icon="@drawable/ic_favorite_outline"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:padding="12dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.TransferServis.Label"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_route_subtitle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TransferServis.SectionTitle"
            android:layout_marginTop="20dp"
            android:text="@string/ux_vehicle_class" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tariffToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonComfort"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tariff_comfort"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/ts_tariff_button_text"
                app:backgroundTint="@color/ts_tariff_button_bg"
                app:strokeColor="@color/ts_tariff_button_stroke"
                app:strokeWidth="1dp"
                android:minHeight="52dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBusiness"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tariff_business"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/ts_tariff_button_text"
                app:backgroundTint="@color/ts_tariff_button_bg"
                app:strokeColor="@color/ts_tariff_button_stroke"
                app:strokeWidth="1dp"
                android:minHeight="52dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMinivan"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tariff_minivan"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/ts_tariff_button_text"
                app:backgroundTint="@color/ts_tariff_button_bg"
                app:strokeColor="@color/ts_tariff_button_stroke"
                app:strokeWidth="1dp"
                android:minHeight="52dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView
            android:id="@+id/tariffDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/tariff_comfort_description"
            android:textColor="@color/ts_text_secondary"
            android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/calculateButton"
            android:text="@string/quote_calculate"
            style="@style/Widget.TransferServis.PrimaryButton"
            android:layout_marginTop="12dp" />
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:indicatorColor="@color/ts_primary"
            app:indicatorSize="32dp" />
        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/ts_error"
            android:textSize="14sp"
            android:visibility="gone" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TransferServis.Label"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:text="@string/ux_service_short" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
