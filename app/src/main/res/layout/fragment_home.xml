<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/ts_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <!-- =========================
             BRAND
        ========================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:letterSpacing="0.12"

            android:text="@string/home_overline"
            android:textColor="@color/ts_primary"

            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="@string/home_title"

            android:textColor="@color/ts_text_primary"

            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:lineSpacingExtra="2dp"

            android:text="@string/home_slogan"

            android:textColor="@color/ts_text_secondary"

            android:textSize="14sp" />

        <!-- Pending request can be recovered without the in-memory route quote. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pendingOrderNoticeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/ts_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ts_error"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pending_order_home_title"
                    android:textColor="@color/ts_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pending_order_home_message"
                    android:textColor="@color/ts_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/pendingOrderReference"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/ts_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pendingOrderCopyButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/pending_order_copy_reference"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pendingOrderRecoverButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/pending_order_recover"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    app:cornerRadius="12dp" />


            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/pendingOrderRecoveryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/ts_text_primary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- =========================
             ROUTE CARD
        ========================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            app:cardBackgroundColor="@color/ts_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/ts_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/home_route_title"

                    android:textColor="@color/ts_text_primary"

                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:text="@string/home_route_subtitle"

                    android:textColor="@color/ts_text_secondary"

                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:hint="@string/quote_from_hint"

                    app:boxBackgroundColor="@color/ts_surface_high"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"

                    app:boxStrokeColor="@color/ts_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fromInput"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:inputType="textPostalAddress"

                        android:maxLines="3"

                        android:textColor="@color/ts_text_primary"
                        android:textColorHint="@color/ts_text_muted" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Swap only the entered addresses; no quote or order request. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/swapRouteButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/home_swap_route"
                    android:text="@string/home_swap_route"
                    android:textAllCaps="false"
                    android:textColor="@color/ts_text_primary"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_swap_vertical"
                    app:iconTint="@color/ts_primary"
                    app:iconPadding="8dp"
                    app:strokeColor="@color/ts_outline" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:hint="@string/quote_to_hint"

                    app:boxBackgroundColor="@color/ts_surface_high"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"

                    app:boxStrokeColor="@color/ts_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/toInput"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:inputType="textPostalAddress"

                        android:maxLines="3"

                        android:textColor="@color/ts_text_primary"
                        android:textColorHint="@color/ts_text_muted" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- =========================
                     TARIFF
                ========================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="24dp"

                    android:text="@string/quote_tariff_title"

                    android:textColor="@color/ts_text_primary"

                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:text="@string/home_tariff_subtitle"

                    android:textColor="@color/ts_text_secondary"

                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/tariffToggleGroup"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonComfort"

                        style="?attr/materialButtonOutlinedStyle"

                        android:layout_width="0dp"
                        android:layout_height="52dp"

                        android:layout_weight="1"

                        android:text="@string/tariff_comfort"
                        android:textAllCaps="false"

                        android:textSize="13sp"
                        android:textColor="@color/ts_tariff_button_text"
                        app:backgroundTint="@color/ts_tariff_button_bg"
                        app:strokeColor="@color/ts_tariff_button_stroke"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonBusiness"

                        style="?attr/materialButtonOutlinedStyle"

                        android:layout_width="0dp"
                        android:layout_height="52dp"

                        android:layout_weight="1"

                        android:text="@string/tariff_business"
                        android:textAllCaps="false"

                        android:textSize="13sp"
                        android:textColor="@color/ts_tariff_button_text"
                        app:backgroundTint="@color/ts_tariff_button_bg"
                        app:strokeColor="@color/ts_tariff_button_stroke"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonMinivan"

                        style="?attr/materialButtonOutlinedStyle"

                        android:layout_width="0dp"
                        android:layout_height="52dp"

                        android:layout_weight="1"

                        android:text="@string/tariff_minivan"
                        android:textAllCaps="false"

                        android:textSize="13sp"
                        android:textColor="@color/ts_tariff_button_text"
                        app:backgroundTint="@color/ts_tariff_button_bg"
                        app:strokeColor="@color/ts_tariff_button_stroke"
                        app:strokeWidth="1dp" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/tariffDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/tariff_comfort_description"
                    android:textColor="@color/ts_text_secondary"
                    android:textSize="14sp" />

                <!-- =========================
                     CALCULATE
                ========================== -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calculateButton"

                    android:layout_width="match_parent"
                    android:layout_height="56dp"

                    android:layout_marginTop="24dp"

                    android:text="@string/quote_calculate"
                    android:textAllCaps="false"

                    android:textSize="16sp"
                    android:textStyle="bold"

                    app:backgroundTint="@color/ts_action_primary"
                    app:cornerRadius="16dp" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressIndicator"

                    android:layout_width="32dp"
                    android:layout_height="32dp"

                    android:layout_gravity="center_horizontal"

                    android:layout_marginTop="20dp"

                    android:visibility="gone"

                    app:indicatorColor="@color/ts_primary"
                    app:indicatorSize="32dp" />

                <TextView
                    android:id="@+id/errorText"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:gravity="center"

                    android:textColor="@color/ts_error"

                    android:textSize="14sp"

                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Service details are shown in the trust card below. -->

        <!-- =========================
     ACTIVE ORDER
========================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/activeOrderButton"

            style="?attr/materialButtonOutlinedStyle"

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="16dp"

            android:text="@string/active_order_open"
            android:textAllCaps="false"

            android:textSize="16sp"
            android:textStyle="bold"

            android:visibility="gone"

            app:cornerRadius="16dp"
            app:strokeColor="@color/ts_primary"
            app:strokeWidth="1dp" />

        <!-- =========================
             TRUST
        ========================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            app:cardBackgroundColor="@color/ts_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/ts_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/home_service_title"

                    android:textColor="@color/ts_text_primary"

                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="@string/home_service_fixed_price"

                    android:textColor="@color/ts_text_secondary"

                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="10dp"

                    android:text="@string/home_service_no_transfer"

                    android:textColor="@color/ts_text_secondary"

                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="10dp"

                    android:text="@string/home_service_private"

                    android:textColor="@color/ts_text_secondary"

                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>