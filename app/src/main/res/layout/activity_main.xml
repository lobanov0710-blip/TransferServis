<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"

    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <!-- =========================
             QUOTE
        ========================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="@string/quote_screen_title"

            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="@string/quote_screen_subtitle"

            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/fromInputLayout"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:hint="@string/quote_from_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/fromInput"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="textPostalAddress"
                android:maxLines="3" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/toInputLayout"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:hint="@string/quote_to_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/toInput"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="textPostalAddress"
                android:maxLines="3" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:text="@string/quote_tariff_title"

            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tariffToggleGroup"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonComfort"

                style="?attr/materialButtonOutlinedStyle"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="@string/tariff_comfort"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBusiness"

                style="?attr/materialButtonOutlinedStyle"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="@string/tariff_business"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMinivan"

                style="?attr/materialButtonOutlinedStyle"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="@string/tariff_minivan"
                android:textAllCaps="false" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calculateButton"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:text="@string/quote_calculate"
            android:textAllCaps="false" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressIndicator"

            android:layout_width="32dp"
            android:layout_height="32dp"

            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"

            android:visibility="gone"

            app:indicatorSize="32dp"

            tools:visibility="visible" />

        <TextView
            android:id="@+id/errorText"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            android:textAppearance="?attr/textAppearanceBodyMedium"

            android:visibility="gone"

            tools:text="Не удалось выполнить расчёт."
            tools:visibility="visible" />

        <!-- =========================
             QUOTE RESULT
        ========================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultCard"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:visibility="gone"

            app:cardUseCompatPadding="true"

            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/quote_result_title"

                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <TextView
                    android:id="@+id/resultPrice"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:textAppearance="?attr/textAppearanceHeadlineMedium"

                    tools:text="25 000 ₽" />

                <TextView
                    android:id="@+id/resultFrom"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="18dp"

                    tools:text="Откуда: Нижний Новгород" />

                <TextView
                    android:id="@+id/resultTo"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    tools:text="Куда: Москва" />

                <TextView
                    android:id="@+id/resultTariff"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    tools:text="Тариф: Комфорт" />

                <TextView
                    android:id="@+id/resultDistance"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    tools:text="Расстояние: 420.4 км" />

                <TextView
                    android:id="@+id/resultDuration"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    tools:text="Время в пути: 360 мин" />

                <TextView
                    android:id="@+id/resultQuoteId"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:textAppearance="?attr/textAppearanceBodySmall"

                    tools:text="Quote ID: 12345678-..." />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- =========================
             BOOKING
        ========================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bookingCard"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:visibility="gone"

            app:cardUseCompatPadding="true"

            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/booking_title"

                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:text="@string/booking_subtitle"

                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:hint="@string/booking_name_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/bookingNameInput"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        android:maxLength="100"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:hint="@string/booking_phone_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/bookingPhoneInput"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:inputType="phone"
                        android:maxLength="40"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:hint="@string/booking_date_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/bookingDateInput"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"

                        tools:text="2026-10-15" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:hint="@string/booking_comment_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/bookingCommentInput"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="top|start"

                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences|textMultiLine"

                        android:maxLength="2000"
                        android:maxLines="5"
                        android:minLines="3" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/orderButton"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:enabled="false"

                    android:text="@string/booking_submit"
                    android:textAllCaps="false" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/orderProgressIndicator"

                    android:layout_width="32dp"
                    android:layout_height="32dp"

                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"

                    android:visibility="gone"

                    app:indicatorSize="32dp"

                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/orderErrorText"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:textAppearance="?attr/textAppearanceBodyMedium"

                    android:visibility="gone"

                    tools:text="Не удалось создать заявку."
                    tools:visibility="visible" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- =========================
             ORDER SUCCESS
        ========================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/orderSuccessCard"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:visibility="gone"

            app:cardUseCompatPadding="true"

            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/order_success_title"

                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="@string/order_success_message"

                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/orderSuccessId"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    tools:text="ID заявки: ..." />

                <TextView
                    android:id="@+id/orderSuccessStatus"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    tools:text="Статус: Новая" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>