<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/ts_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:gravity="center_horizontal"
        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingTop="48dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <!-- SUCCESS ICON -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="76dp"
            android:layout_height="76dp"

            app:cardBackgroundColor="@color/ts_success"
            app:cardCornerRadius="38dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center"

                android:text="@string/order_success_check"
                android:textColor="@color/white"

                android:textSize="38sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:gravity="center"
            android:letterSpacing="0.12"

            android:text="@string/order_success_overline"
            android:textColor="@color/ts_success"

            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:gravity="center"

            android:text="@string/order_success_title"
            android:textColor="@color/ts_text_primary"

            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:gravity="center"
            android:lineSpacingExtra="2dp"

            android:text="@string/order_success_message"
            android:textColor="@color/ts_text_secondary"

            android:textSize="15sp" />

        <!-- ORDER DETAILS -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="30dp"

            app:cardBackgroundColor="@color/ts_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/ts_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/order_success_details_title"
                    android:textColor="@color/ts_text_primary"

                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- ORDER ID -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:text="@string/order_success_id_label"
                    android:textColor="@color/ts_text_muted"

                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/orderSuccessId"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:textColor="@color/ts_text_primary"

                    android:textIsSelectable="true"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"

                    android:layout_marginTop="20dp"

                    android:background="@color/ts_divider" />

                <!-- STATUS -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="18dp"

                    android:text="@string/order_success_status_label"
                    android:textColor="@color/ts_text_muted"

                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/orderSuccessStatus"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:textColor="@color/ts_success"

                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- NEXT STEP -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            app:cardBackgroundColor="@color/ts_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/ts_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/order_next_title"
                    android:textColor="@color/ts_text_primary"

                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:lineSpacingExtra="2dp"

                    android:text="@string/order_next_message"
                    android:textColor="@color/ts_text_secondary"

                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ERROR -->

        <TextView
            android:id="@+id/orderSuccessError"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:gravity="center"

            android:textColor="@color/ts_error"

            android:textSize="14sp"

            android:visibility="gone" />

        <!-- NEW TRIP -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/newTripButton"

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="28dp"

            android:text="@string/order_new_trip"
            android:textAllCaps="false"

            android:textSize="16sp"
            android:textStyle="bold"

            app:backgroundTint="@color/ts_primary"
            app:cornerRadius="16dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>