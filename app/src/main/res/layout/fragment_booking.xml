<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ts_background"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TransferServis.Overline"
            android:text="@string/ux_brand" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TransferServis.ScreenTitle"
            android:layout_marginTop="8dp"
            android:accessibilityHeading="true"
            android:text="@string/ux_booking_title" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.TransferServis.Card"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.TransferServis.SectionTitle"
                    android:text="@string/booking_trip_summary_title" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.TransferServis.Label"
                        android:text="@string/quote_from_hint" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.TransferServis.Value"
                        android:layout_marginTop="4dp"
                        android:id="@+id/bookingFrom" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.TransferServis.Label"
                        android:text="@string/quote_to_hint" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.TransferServis.Value"
                        android:layout_marginTop="4dp"
                        android:id="@+id/bookingTo" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.TransferServis.Label"
                        android:text="@string/quote_tariff_title" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.TransferServis.Value"
                        android:layout_marginTop="4dp"
                        android:id="@+id/bookingTariff" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.TransferServis.Label"
                        android:text="@string/quote_distance_label" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.TransferServis.Value"
                        android:layout_marginTop="4dp"
                        android:id="@+id/bookingDistance" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.TransferServis.PriceSmall"
                    android:layout_marginTop="12dp"
                    android:id="@+id/bookingPrice" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TransferServis.SectionTitle"
            android:layout_marginTop="20dp"
            android:text="@string/booking_passenger_title" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/booking_name_hint"
            app:boxBackgroundColor="@color/ts_surface_high"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/ts_primary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/bookingNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textPersonName"
                android:maxLength="100"
                android:maxLines="1"
                android:textColor="@color/ts_text_primary"
                android:textColorHint="@color/ts_text_muted"
                android:textSize="16sp"
                android:minHeight="56dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/bookingPhoneLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/booking_phone_hint"
            app:boxBackgroundColor="@color/ts_surface_high"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/ts_primary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/bookingPhoneInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="phone"
                android:maxLength="40"
                android:maxLines="1"
                android:textColor="@color/ts_text_primary"
                android:textColorHint="@color/ts_text_muted"
                android:textSize="16sp"
                android:minHeight="56dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TransferServis.SectionTitle"
            android:layout_marginTop="20dp"
            android:text="@string/ux_date_comment_title" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/booking_date_hint"
            app:boxBackgroundColor="@color/ts_surface_high"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/ts_primary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/bookingDateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none"
                android:textColor="@color/ts_text_primary"
                android:textSize="16sp"
                android:minHeight="56dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/booking_comment_hint"
            app:boxBackgroundColor="@color/ts_surface_high"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/ts_primary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/bookingCommentInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="2000"
                android:maxLines="5"
                android:minLines="3"
                android:textColor="@color/ts_text_primary"
                android:textColorHint="@color/ts_text_muted"
                android:textSize="16sp"
                android:minHeight="56dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:id="@+id/orderErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/ts_error"
            android:textSize="14sp"
            android:visibility="gone" />
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/orderProgressIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:indicatorColor="@color/ts_primary"
            app:indicatorSize="32dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TransferServis.Body"
            android:layout_marginTop="12dp"
            android:text="@string/ux_booking_check" />
        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/orderButton"
            android:text="@string/ux_send_booking"
            style="@style/Widget.TransferServis.PrimaryButton"
            android:layout_marginTop="12dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TransferServis.Label"
            android:layout_marginTop="8dp"
            android:text="@string/ux_confirmation_explanation" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
