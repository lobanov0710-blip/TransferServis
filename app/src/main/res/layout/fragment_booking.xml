<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/ts_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:letterSpacing="0.12"

            android:text="@string/booking_overline"
            android:textColor="@color/ts_primary"

            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="@string/booking_title"
            android:textColor="@color/ts_text_primary"

            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="@string/booking_subtitle"
            android:textColor="@color/ts_text_secondary"

            android:textSize="15sp" />

        <!-- ROUTE SUMMARY -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            app:cardBackgroundColor="@color/ts_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/ts_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/booking_trip_summary_title"

                    android:textColor="@color/ts_text_primary"

                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bookingFrom"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:textColor="@color/ts_text_primary"

                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="3dp"
                    android:layout_marginTop="6dp"

                    android:text="↓"
                    android:textColor="@color/ts_primary"

                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bookingTo"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="6dp"

                    android:textColor="@color/ts_text_primary"

                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"

                    android:layout_marginTop="18dp"

                    android:background="@color/ts_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="@string/quote_tariff_label"

                            android:textColor="@color/ts_text_muted"

                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/bookingTariff"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="4dp"

                            android:textColor="@color/ts_text_primary"

                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="@string/quote_distance_label"

                            android:textColor="@color/ts_text_muted"

                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/bookingDistance"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="4dp"

                            android:textColor="@color/ts_text_primary"

                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="18dp"

                    android:text="@string/booking_price_label"

                    android:textColor="@color/ts_text_muted"

                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/bookingPrice"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textColor="@color/ts_primary"

                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- PASSENGER -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            app:cardBackgroundColor="@color/ts_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/ts_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/booking_passenger_title"

                    android:textColor="@color/ts_text_primary"

                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="18dp"

                    android:hint="@string/booking_name_hint"

                    app:boxBackgroundColor="@color/ts_surface_high"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"

                    app:boxStrokeColor="@color/ts_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/bookingNameInput"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"

                        android:maxLength="100"
                        android:maxLines="1"

                        android:textColor="@color/ts_text_primary"
                        android:textColorHint="@color/ts_text_muted" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:hint="@string/booking_phone_hint"

                    app:boxBackgroundColor="@color/ts_surface_high"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"

                    app:boxStrokeColor="@color/ts_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/bookingPhoneInput"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:imeOptions="actionNext"
                        android:inputType="phone"

                        android:maxLength="40"
                        android:maxLines="1"

                        android:textColor="@color/ts_text_primary"
                        android:textColorHint="@color/ts_text_muted" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:hint="@string/booking_date_hint"

                    app:boxBackgroundColor="@color/ts_surface_high"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"

                    app:boxStrokeColor="@color/ts_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/bookingDateInput"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"

                        android:textColor="@color/ts_text_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:hint="@string/booking_comment_hint"

                    app:boxBackgroundColor="@color/ts_surface_high"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"

                    app:boxStrokeColor="@color/ts_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/bookingCommentInput"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="top|start"

                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences|textMultiLine"

                        android:maxLength="2000"
                        android:maxLines="5"
                        android:minLines="3"

                        android:textColor="@color/ts_text_primary"
                        android:textColorHint="@color/ts_text_muted" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ERROR -->

        <TextView
            android:id="@+id/orderErrorText"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            android:gravity="center"

            android:textColor="@color/ts_error"

            android:textSize="14sp"

            android:visibility="gone" />

        <!-- PROGRESS -->

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/orderProgressIndicator"

            android:layout_width="32dp"
            android:layout_height="32dp"

            android:layout_gravity="center_horizontal"

            android:layout_marginTop="18dp"

            android:visibility="gone"

            app:indicatorColor="@color/ts_primary"
            app:indicatorSize="32dp" />

        <!-- SUBMIT -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/orderButton"

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="22dp"

            android:text="@string/booking_submit"
            android:textAllCaps="false"

            android:textSize="16sp"
            android:textStyle="bold"

            app:backgroundTint="@color/ts_primary"
            app:cornerRadius="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:gravity="center"

            android:text="@string/booking_submit_note"

            android:textColor="@color/ts_text_muted"

            android:textSize="12sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>