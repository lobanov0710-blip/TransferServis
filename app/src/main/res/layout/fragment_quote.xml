<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/ts_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:letterSpacing="0.12"

            android:text="@string/quote_result_overline"
            android:textColor="@color/ts_primary"

            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="@string/quote_result_title"
            android:textColor="@color/ts_text_primary"

            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="@string/quote_result_subtitle"
            android:textColor="@color/ts_text_secondary"

            android:textSize="15sp" />

        <!-- PRICE -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            app:cardBackgroundColor="@color/ts_primary_container"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/ts_primary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/quote_price_label"

                    android:textColor="@color/ts_text_secondary"

                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/quotePrice"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:textColor="@color/white"

                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="6dp"

                    android:text="@string/quote_price_note"

                    android:textColor="@color/ts_text_secondary"

                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ROUTE -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            app:cardBackgroundColor="@color/ts_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/ts_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/quote_route_label"

                    android:textColor="@color/ts_text_secondary"

                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quoteFrom"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="14dp"

                    android:textColor="@color/ts_text_primary"

                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="3dp"
                    android:layout_marginTop="8dp"

                    android:text="↓"

                    android:textColor="@color/ts_primary"

                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quoteTo"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:textColor="@color/ts_text_primary"

                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- TRIP DETAILS -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            app:cardBackgroundColor="@color/ts_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/ts_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/quote_details_title"

                    android:textColor="@color/ts_text_primary"

                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="18dp"

                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="@string/quote_tariff_label"

                            android:textColor="@color/ts_text_muted"

                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/quoteTariff"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="4dp"

                            android:textColor="@color/ts_text_primary"

                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="@string/quote_distance_label"

                            android:textColor="@color/ts_text_muted"

                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/quoteDistance"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="4dp"

                            android:textColor="@color/ts_text_primary"

                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="@string/quote_duration_label"

                        android:textColor="@color/ts_text_muted"

                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/quoteDuration"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:textColor="@color/ts_text_primary"

                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- INFO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"

            android:gravity="center"

            android:text="@string/quote_server_price_note"

            android:textColor="@color/ts_text_secondary"

            android:textSize="13sp" />

        <!-- ERROR -->

        <TextView
            android:id="@+id/quoteErrorText"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            android:gravity="center"

            android:textColor="@color/ts_error"

            android:textSize="14sp"

            android:visibility="gone" />

        <!-- ACTION -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueBookingButton"

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="24dp"

            android:text="@string/quote_continue"
            android:textAllCaps="false"

            android:textSize="16sp"
            android:textStyle="bold"

            app:backgroundTint="@color/ts_primary"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/changeRouteButton"

            style="?attr/materialButtonOutlinedStyle"

            android:layout_width="match_parent"
            android:layout_height="52dp"

            android:layout_marginTop="10dp"

            android:text="@string/quote_change_route"
            android:textAllCaps="false"

            android:textColor="@color/ts_text_primary"

            app:cornerRadius="16dp"
            app:strokeColor="@color/ts_outline" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>