<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/ts_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingTop="32dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <!-- =========================
             HEADER
        ========================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:letterSpacing="0.12"

            android:text="@string/active_order_overline"
            android:textColor="@color/ts_primary"

            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="@string/active_order_title"
            android:textColor="@color/ts_text_primary"

            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:lineSpacingExtra="2dp"

            android:text="@string/active_order_subtitle"
            android:textColor="@color/ts_text_secondary"

            android:textSize="15sp" />

        <!-- =========================
             LOADING
        ========================== -->

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/activeOrderProgress"

            android:layout_width="40dp"
            android:layout_height="40dp"

            android:layout_gravity="center_horizontal"

            android:layout_marginTop="48dp"

            android:visibility="visible"

            app:indicatorColor="@color/ts_primary"
            app:indicatorSize="40dp" />

        <!-- =========================
             EMPTY
        ========================== -->

        <LinearLayout
            android:id="@+id/activeOrderEmptyContainer"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="32dp"

            android:gravity="center_horizontal"
            android:orientation="vertical"

            android:padding="24dp"

            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center"

                android:text="@string/active_order_empty_title"
                android:textColor="@color/ts_text_primary"

                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="8dp"

                android:gravity="center"
                android:lineSpacingExtra="2dp"

                android:text="@string/active_order_empty_message"
                android:textColor="@color/ts_text_secondary"

                android:textSize="14sp" />

        </LinearLayout>

        <!-- =========================
             ORDER CONTENT
        ========================== -->

        <LinearLayout
            android:id="@+id/activeOrderContent"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:visibility="gone">

            <!-- STATUS -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="28dp"

                app:cardBackgroundColor="@color/ts_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"

                app:strokeColor="@color/ts_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="@string/active_order_status_label"
                        android:textColor="@color/ts_text_muted"

                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/activeOrderStatus"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="6dp"

                        android:textColor="@color/ts_primary"

                        android:textSize="24sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ROUTE -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                app:cardBackgroundColor="@color/ts_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"

                app:strokeColor="@color/ts_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="@string/active_order_route_label"
                        android:textColor="@color/ts_text_muted"

                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/activeOrderRoute"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="6dp"

                        android:textColor="@color/ts_text_primary"

                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"

                        android:layout_marginTop="18dp"

                        android:background="@color/ts_divider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="16dp"

                        android:text="@string/active_order_from_label"
                        android:textColor="@color/ts_text_muted"

                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/activeOrderFrom"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:textColor="@color/ts_text_primary"

                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="14dp"

                        android:text="@string/active_order_to_label"
                        android:textColor="@color/ts_text_muted"

                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/activeOrderTo"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:textColor="@color/ts_text_primary"

                        android:textSize="15sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- DETAILS -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                app:cardBackgroundColor="@color/ts_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"

                app:strokeColor="@color/ts_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="@string/active_order_date_label"
                        android:textColor="@color/ts_text_muted"

                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/activeOrderDate"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:textColor="@color/ts_text_primary"

                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="16dp"

                        android:text="@string/active_order_tariff_label"
                        android:textColor="@color/ts_text_muted"

                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/activeOrderTariff"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:textColor="@color/ts_text_primary"

                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="16dp"

                        android:text="@string/active_order_distance_label"
                        android:textColor="@color/ts_text_muted"

                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/activeOrderDistance"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:textColor="@color/ts_text_primary"

                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="16dp"

                        android:text="@string/active_order_duration_label"
                        android:textColor="@color/ts_text_muted"

                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/activeOrderDuration"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:textColor="@color/ts_text_primary"

                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="16dp"

                        android:text="@string/active_order_price_label"
                        android:textColor="@color/ts_text_muted"

                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/activeOrderPrice"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:textColor="@color/ts_secondary"

                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"

                        android:layout_marginTop="20dp"

                        android:background="@color/ts_divider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="18dp"

                        android:text="@string/active_order_id_label"
                        android:textColor="@color/ts_text_muted"

                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/activeOrderId"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:textColor="@color/ts_text_secondary"

                        android:textIsSelectable="true"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- =========================
             ERROR
        ========================== -->

        <TextView
            android:id="@+id/activeOrderError"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:gravity="center"
            android:lineSpacingExtra="2dp"

            android:textColor="@color/ts_error"

            android:textSize="14sp"

            android:visibility="gone" />

        <!-- =========================
             REFRESH
        ========================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/activeOrderRefreshButton"

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="24dp"

            android:text="@string/active_order_refresh"
            android:textAllCaps="false"

            android:textSize="16sp"
            android:textStyle="bold"

            app:backgroundTint="@color/ts_primary"
            app:cornerRadius="16dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>