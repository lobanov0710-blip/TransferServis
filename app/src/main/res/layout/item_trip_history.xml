<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.TransferServis.Label"
        android:layout_marginTop="16dp"
        android:accessibilityHeading="true"
        android:id="@+id/tripMonth" />
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.TransferServis.Card"
        android:layout_marginTop="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.TransferServis.Label"
                android:id="@+id/tripDate" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.TransferServis.Status"
                android:layout_marginTop="8dp"
                android:id="@+id/tripStatus" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.TransferServis.SectionTitle"
                android:layout_marginTop="12dp"
                android:id="@+id/tripFrom" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.TransferServis.Value"
                android:layout_marginTop="6dp"
                android:id="@+id/tripTo" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.TransferServis.Body"
                android:layout_marginTop="12dp"
                android:id="@+id/tripMeta" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.TransferServis.PriceSmall"
                android:layout_marginTop="8dp"
                android:id="@+id/tripPrice" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.TransferServis.Label"
                android:layout_marginTop="8dp"
                android:id="@+id/tripOrderId" />
            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tripOpenButton"
                android:text="@string/ux_open_trip"
                style="@style/Widget.TransferServis.SecondaryButton"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tripRepeatButton"
                android:text="@string/history_repeat_route"
                style="@style/Widget.TransferServis.SecondaryButton"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
