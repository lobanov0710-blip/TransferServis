<?xml version="1.0" encoding="utf-8"?>

<full-backup-content>

    <!--
        Персональные данные пассажира
        не отправляем в Auto Backup.
    -->
    <exclude
        domain="sharedpref"
        path="passenger_profile.xml" />

    <!-- Сессия зашифрована ключом AndroidKeyStore этого устройства. -->
    <exclude
        domain="sharedpref"
        path="passenger_order_session.xml" />

    <!-- Contains an encrypted in-flight booking, bound to a device Keystore key. -->
    <exclude
        domain="sharedpref"
        path="passenger_pending_order.xml" />

    <!-- User opt-in must not transfer to another device automatically. -->
    <exclude
        domain="sharedpref"
        path="passenger_push_consent_v1.xml" />

    <!-- Device-scoped installation identity must never follow a cloud restore. -->
    <exclude
        domain="sharedpref"
        path="passenger_push_installation_v1.xml" />

    <!--
        Локальная история поездок
        остаётся только на устройстве.
    -->
    <exclude
        domain="database"
        path="." />

</full-backup-content>
