<?xml version="1.0" encoding="utf-8"?>

<network-security-config>

    <domain-config
        cleartextTrafficPermitted="false">

        <domain includeSubdomains="false">
            transfer-servis52.ru
        </domain>

        <trust-anchors>

            <!--
                Обычные системные CA.
                На современных Android этого достаточно.
            -->
            <certificates src="system" />

            <!--
                Дополнительный официальный root
                Let's Encrypt для Android 7.0 / API 24.
            -->
            <certificates src="@raw/isrg_root_x1" />

        </trust-anchors>

    </domain-config>

</network-security-config>