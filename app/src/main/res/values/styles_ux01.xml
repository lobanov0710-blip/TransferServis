<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.TransferServis.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ts_text_secondary</item>
    </style>
    <style name="TextAppearance.TransferServis.Value" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ts_text_primary</item>
    </style>
    <style name="TextAppearance.TransferServis.Status" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ts_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.TransferServis.Price" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">38sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ts_text_primary</item>
    </style>
    <style name="TextAppearance.TransferServis.PriceSmall" parent="TextAppearance.TransferServis.Price">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/ts_secondary</item>
    </style>
    <style name="Widget.TransferServis.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/ts_action_primary</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="Widget.TransferServis.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/ts_text_primary</item>
        <item name="iconTint">@color/ts_text_secondary</item>
        <item name="strokeColor">@color/ts_outline</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="Widget.TransferServis.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/ts_surface</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/ts_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
